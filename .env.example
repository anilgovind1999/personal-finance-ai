# Firebase configuration for accounts and cross-device sync.
#
# Copy to .env.local and fill in from your Firebase project:
#   Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup
#
# These values are NOT secrets. A Firebase web config is designed to be public;
# what protects your data is the rules in firestore.rules plus Firebase Auth.
# Leave this file blank or absent and the app runs entirely on-device, with no
# accounts and no sync.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Only set if you enabled Google Analytics on the Firebase project.
# Without it, no analytics code runs at all.
VITE_FIREBASE_MEASUREMENT_ID=

# Your own email address. Sample-data tools are hidden from everyone else, so a
# real user is not offered nine months of invented history. This is tidiness,
# not access control — the security boundary is firestore.rules.
VITE_ADMIN_EMAIL=
