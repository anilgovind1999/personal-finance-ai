rules_version = '2';

// Security rules for FinSight.
//
// This file is what actually keeps one person's ledger away from another's.
// The sign-in screen in the app is only a door; these rules are the lock, and
// they are enforced by Firestore itself, so a modified client cannot get past
// them. Deploy them with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's ledger lives under their own uid and is readable and writable
    // by that user alone. There is no rule granting anyone else access, and
    // no admin path — deliberately, since nobody needs to read this data.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Anything outside a user's own subtree is denied. This default matters:
    // without it, a future collection added at the root would be wide open.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
