rules_version = '2';

// Security rules for FinSight.
//
// These rules — not the sign-in screen — are what keep one person's ledger away
// from another's. They are enforced by Firestore itself, so a modified client
// cannot talk its way past them.
//
// Ownership is keyed to the Firebase Auth UID, never to an email address. An
// email can be changed or re-registered; a UID cannot, and it is the only
// identifier Firestore can verify against the request.
//
// Deploy with:  npx firebase-tools deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone may register, but a confirmed email address is required before any
    // data can be read or written. Firebase issues a token claim for this, so
    // the check cannot be spoofed by the client.
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // A user's ledger. `userId` is matched against the caller's own UID, so
    // this rule can only ever grant a user access to their own subtree — there
    // is no path by which one user reaches another's documents.
    match /users/{userId}/{document=**} {
      allow read, write: if verified() && request.auth.uid == userId;
    }

    // Everything else is denied. This default matters: without it, a collection
    // added at the root in future would be wide open to any signed-in user.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
