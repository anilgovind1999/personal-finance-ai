{
  "name": "personal-finance-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI-powered personal finance & expense intelligence app",
  "scripts": {
    "predev": "node scripts/vendor-ocr.mjs",
    "dev": "vite",
    "prebuild": "node scripts/vendor-ocr.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/vendor-ocr.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "vendor:ocr": "node scripts/vendor-ocr.mjs",
    "build:preview": "vite build --config vite.artifact.config.ts && node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "firebase": "^11.10.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "tesseract.js": "^5.1.1",
    "tesseract.js-core": "^5.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
